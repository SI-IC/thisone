    "happy-dom": "20.6.1",
    "husky": "9.1.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "ws": "8.19.0"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@vue/compiler-core": "^3.5.41",
    "@vue/compiler-sfc": "^3.5.41",
    "modern-screenshot": "^4.7.0"
