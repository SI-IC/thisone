  "description": "Send element-anchored feedback from a Vue+Vite dev preview to Claude Code (Alt+C).",
  "type": "module",
  "license": "MIT",
  "author": "SI-IC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SI-IC/vue-pick-problem-skill.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
